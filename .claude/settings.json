{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./package-lock.json)",
      "Read(./**/*.lock)",
      "Read(./**/*.min.js)",
      "Read(./**/*.min.css)",
      "Read(./**/*.map)",
      "Read(./**/*.log)",
      "Read(./.git/**)",
      "Read(./.cache/**)"
    ]
  }
}
